APP_NAME="Educa Eduit"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=curso_platform
DB_USERNAME=curso_user
DB_PASSWORD=curso_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail (cadastro / recuperação de senha). Troque só o .env em produção (SMTP da empresa).
# Dev com Gmail: MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_SCHEME=tls,
# MAIL_USERNAME=seu@gmail.com, MAIL_PASSWORD=senha_de_app (https://myaccount.google.com/apppasswords)
# Teste local sem enviar: MAIL_MAILER=log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# sync = envia e-mail na hora (bom para testes). database/redis = exige php artisan queue:work
QUEUE_CONNECTION=database

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:8080

GOOGLE_CLIENT_ID=google_client_id_goes_here
GOOGLE_CLIENT_SECRET=google_client_secret_goes_here
GOOGLE_REDIRECT_URI=${APP_URL}/auth/callback
DEFAULT_URI_REDIRECT_POST_GOOGLE=http://localhost:3000/login
SIGN_UP_URI=http://localhost:3000/cadastro

# Certificado PDF: imagem de fundo relativa a public/
CERTIFICATE_BACKGROUND=images/certificates/background.png
CERTIFICATE_PAPER=a4
CERTIFICATE_ORIENTATION=landscape
CERTIFICATE_QR_SIZE=112

CERTIFICATE_PREVIEW_ENABLED=true
CERTIFICATE_PREVIEW_DISK=public
CERTIFICATE_PREVIEW_DIR=certificate-previews
CERTIFICATE_PREVIEW_DPI=150

COURSE_COVER_DISK=public
COURSE_COVER_DIR=course-covers
COURSE_COVER_MAX_KB=2048
COURSE_COVER_MIMES=jpg,jpeg,png,webp